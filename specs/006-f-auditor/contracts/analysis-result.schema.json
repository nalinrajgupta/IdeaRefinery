{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "f-auditor contextual analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "findings", "chunk_attestations", "uncertain_candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_id", "title", "affected_skill", "problem", "impact", "suggested_improvement", "priority", "priority_rationale", "grouping_rationale", "existing_issue_id", "evidence"],
        "properties": {
          "local_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "affected_skill": {"enum": ["refine-idea", "implement-refine-idea", "both"]},
          "problem": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "suggested_improvement": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P1", "P2", "P3"]},
          "priority_rationale": {"type": "string", "minLength": 1},
          "grouping_rationale": {"type": "string", "minLength": 1},
          "existing_issue_id": {"type": ["string", "null"], "pattern": "^FI-[A-Za-z0-9._-]+$"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conversation_id", "occurrence_anchor_message_ids", "supporting_message_ids", "excerpts", "observed_behavior", "expected_behavior", "skill_relevance"],
              "properties": {
                "conversation_id": {"type": "string", "minLength": 1},
                "occurrence_anchor_message_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Origin messages directly recording one occurrence, not surrounding discussion. Identity and chronology derive only from these validated anchors."},
                "supporting_message_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Context citations, disjoint from occurrence anchors. These do not affect occurrence identity or time."},
                "excerpts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "observed_behavior": {"type": "string", "minLength": 1},
                "expected_behavior": {"type": "string", "minLength": 1},
                "skill_relevance": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "chunk_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "reviewed", "finding_ids"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "reviewed": {"type": "boolean"},
          "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "uncertain_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversation_id", "message_ids", "reason"],
        "properties": {
          "conversation_id": {"type": "string", "minLength": 1},
          "message_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
