{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-refinery.local/contracts/run-manifest.schema.json",
  "title": "Idea Refinery Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "feature_id", "status", "created_at", "updated_at",
    "resolved_config_hash", "active_stage", "artifact_hashes", "schema_hashes",
    "stage_commits", "worker_attempts", "repair_counts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["created", "configured", "reviewing", "synthesizing", "planning", "analyzing", "repairing", "blocked", "ready", "ready-degraded"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "resolved_config_hash": {"$ref": "#/$defs/hash"},
    "roster_snapshot_hash": {"$ref": "#/$defs/hash"},
    "active_stage": {"type": "string", "minLength": 1},
    "artifact_hashes": {"$ref": "#/$defs/hashMap"},
    "schema_hashes": {"$ref": "#/$defs/hashMap"},
    "stage_commits": {
      "type": "array",
      "items": {"$ref": "#/$defs/stageCommit"}
    },
    "worker_attempts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2}
    },
    "repair_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2}
    },
    "prior_run_id": {"type": "string", "minLength": 1},
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_role", "affected_coverage_ids", "owner", "rationale", "recorded_at"],
      "properties": {
        "missing_role": {"enum": ["ceo", "product", "architect"]},
        "affected_coverage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^COV-[0-9]+$"}},
        "owner": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashMap": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "stageCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "input_hashes", "output_hashes", "marker_path", "marker_hash", "committed_at", "reusable"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "input_hashes": {"$ref": "#/$defs/hashMap"},
        "output_hashes": {"$ref": "#/$defs/hashMap"},
        "marker_path": {"type": "string", "minLength": 1},
        "marker_hash": {"$ref": "#/$defs/hash"},
        "committed_at": {"type": "string", "format": "date-time"},
        "reusable": {"type": "boolean"}
      }
    }
  }
}
